+  /**
+   * Base Cost of the event card (its Reserve Cost if it is Fleeting, else its Hand Cost, as Target's
+   * maxBaseCost / minBaseCost) compared with $cost: a card targets first, then checks the cost
+   */
+  public static function baseCostCheck($card, $event, $cost, $op = 'GTE')
+  {
+    $target = Cards::get($event['cardId']);
+    $baseCost = $target->hasToken(FLEETING) ? $target->getCostReserve() : $target->getCostHand();
+
+    if ($op == 'GTE') {
+      return $cost <= $baseCost;
+    }
+    if ($op == 'LTE') {
+      return $cost >= $baseCost;
+    }
+  }
+
